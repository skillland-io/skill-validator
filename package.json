{
  "name": "@skillland/validator",
  "version": "0.2.2",
  "description": "Lint SKILL.md agent skills against the Agent Skills spec and the official guidance from Anthropic, OpenAI and Cursor. Every rule quotes its source.",
  "keywords": [
    "agent-skills",
    "skill.md",
    "claude-code",
    "codex",
    "cursor",
    "lint",
    "validator"
  ],
  "homepage": "https://skillland.io/validate/rules",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skillland-io/skill-validator.git"
  },
  "bugs": "https://github.com/skillland-io/skill-validator/issues",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "skillland": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "check-quotes": "tsx scripts/check-quotes.ts",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
